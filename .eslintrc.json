{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/supabase/admin", "**/env.server"],
            "message": "Module serveur uniquement (service role) : interdit hors code serveur."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["lib/supabase/admin.ts", "lib/env.server.ts", "app/api/webhooks/**/*.ts", "scripts/**/*"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}

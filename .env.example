# Noms des variables uniquement. Ne JAMAIS commiter de vraies valeurs.
# Local : valeurs affichées par `supabase start`.

# --- Publiques (exposées au navigateur) ---
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# --- Secrètes (serveur uniquement, jamais dans le frontend ni dans Git) ---
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
